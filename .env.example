# Копирай като .env (локално) или ги задай като Environment Variables във Vercel.

# Ключ от https://aistudio.google.com/apikey. Без него Gemini проверката е изключена.
GEMINI_API_KEY=

# Gemini модели, които се питат едновременно. Позволени са САМО безплатните:
# gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.8-flash, gemini-3.6-flash
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Таймаут за едно повикване (в секунди). При 503/504 всеки модел опитва още веднъж.
GEMINI_TIMEOUT_S=20

# Кога локалният резултат се смята за несигурен и се праща към Gemini
VERIFY_MIN_SCORE=0.85
VERIFY_MIN_MARGIN=0.05
VERIFY_SURE_SCORE=0.95

# Език на информацията от Wikipedia по подразбиране
INFO_LANGUAGE=bg

# Ако е зададено (списък, разделен със запетаи), всяка заявка към /predict иска хедър X-API-Key
API_KEYS=

# Откъде браузърни приложения могат да викат API-то (* = отвсякъде)
CORS_ALLOW_ORIGINS=*

# Лимити за снимките (в байтове)
MAX_UPLOAD_BYTES=4194304
MAX_DOWNLOAD_BYTES=15728640
